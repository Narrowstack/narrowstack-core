# .env.example — copy to .env and fill in values (never commit .env)
#
# Local warehouse compose:
#   cp compose/local-warehouse/.env.example compose/local-warehouse/.env
#   docker compose --env-file compose/local-warehouse/.env -f compose/local-warehouse/docker-compose.yml up
#
# Green-check:
#   cp .env.example .env && edit
#   ./deploy/green-check.sh manifest/examples/example-local-warehouse.yaml

# Postgres (local warehouse)
PG_DATABASE=narrowstack
PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=changeme
PG_PORT=5432

# Per-role warehouse credentials (manifest secrets_refs)
DLT_PG_PASSWORD=
DBT_PG_PASSWORD=
MF_PG_PASSWORD=
API_RO_PG_PASSWORD=
AGENT_PG_PASSWORD=

# Backup target (manifest backup.target_env)
BACKUP_TARGET=

# External warehouse DSN (manifest warehouse.external_dsn_env)
WAREHOUSE_DSN=
