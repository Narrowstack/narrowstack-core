# Narrowstack Core — ideal .env for compose/local-warehouse (warehouse.mode: local).
#
# Local:   cp .env.example .env   (.env is gitignored; never commit it)
# Coolify: enter the same names in the resource's Environment Variables UI as runtime-only values
#          (build-time flag off). Coolify generates SERVICE_PASSWORD_* and SERVICE_URL_* values on
#          first deploy and keeps them across redeploys. Confirm that on the first deploy; if a
#          value is not generated, set it by hand under the same name.
#
# Legend (tag on the comment line above each variable):
#   [required]  compose refuses to render without it
#   [generated] Coolify fills it; locally, fill it yourself: openssl rand -hex 32
#   [optional]  safe default already in docker-compose.yml
#   [stub]      belongs to a surface that is off the initial execution path
#
# Keep comments on their own lines. An inline "# ..." after an empty value becomes the value.
#
# The manifest (deploy/manifest.yaml in the tenant semantics repo) carries env var NAMES only
# (secrets_refs). Inside the containers the role passwords appear under those canon names:
# DLT_PG_PASSWORD, DBT_PG_PASSWORD, MF_PG_PASSWORD, API_RO_PG_PASSWORD.

# =============================================================================================
# Instance
# =============================================================================================
# [required] Stable runtime slug. Must equal manifest tenant_id.
NS_TENANT_ID=example
# [optional] Core release tag; image tags follow it.
NS_CORE_VERSION=dev
# [optional] debug | info | warn
NS_LOG_LEVEL=info

# =============================================================================================
# Tenant semantics repo (private: dlt pipelines, dbt project, MetricFlow metrics, allowlist, manifest)
# =============================================================================================
# [required] SSH clone URL of the tenant semantics repo.
NS_SEMANTICS_REPO=git@github.com:Narrowstack/example-semantics.git
# [required] Tag or SHA. Must equal manifest semantics_ref (green-check stage 3 enforces it).
NS_SEMANTICS_REF=v0.1.0
# [required] Base64 of a GitHub read-only deploy key scoped to the semantics repo only. Runtime-only.
# Generate: ssh-keygen -t ed25519 -N "" -f semantics_key && base64 < semantics_key
NS_SEMANTICS_DEPLOY_KEY_B64=replace-with-base64-read-only-deploy-key
# [optional] Manifest path inside the semantics repo.
NS_MANIFEST_PATH=deploy/manifest.yaml

# =============================================================================================
# Warehouse (Postgres 16 + pgvector). The superuser is used only by the runner's bootstrap stage.
# =============================================================================================
# [optional]
PG_DATABASE=narrowstack
# [optional]
PG_SUPERUSER=postgres
# [generated] Superuser password (postgres service + runner bootstrap stage only).
SERVICE_PASSWORD_64_POSTGRES=
# [generated] Role ns_loader (dlt, writes raw_* only). Runner sees it as DLT_PG_PASSWORD.
SERVICE_PASSWORD_64_LOADER=
# [generated] Role ns_transformer (dbt). Runner sees it as DBT_PG_PASSWORD.
SERVICE_PASSWORD_64_TRANSFORMER=
# [generated] Role ns_query (MetricFlow execution, published schemas only). Runner + api see it as MF_PG_PASSWORD.
SERVICE_PASSWORD_64_QUERY=
# [generated] Role ns_api (ns_core schema: token hashes, audit log). Runner + api see it as API_RO_PG_PASSWORD.
SERVICE_PASSWORD_64_APISTATE=
# AGENT_PG_PASSWORD is intentionally absent: agents authenticate to the API with a principal token
# and never hold a database credential (proposed retirement of manifest agent_pg_password).

# =============================================================================================
# Access: the API / MCP / CLI is the front door and bouncer.
# The mode is set in the manifest `access` block (proposed). No `access` block = OPEN MODE:
# callers are not authenticated and row scoping is off. Strongly advised against; every
# response is marked open. Set access up during instance setup (see README, step 5).
# =============================================================================================
# [generated] HMAC pepper for principal-token hashes. Rotating it invalidates every issued token.
SERVICE_PASSWORD_64_TOKENPEPPER=
# [optional] Longest lifetime a principal token may be issued for.
NS_CORE_TOKEN_MAX_TTL_DAYS=90
# [stub] IdP issuer URL whose JWTs Core validates (oidc mode, needed when a chat edge lands).
NS_CORE_OIDC_ISSUER=
# [stub] Expected audience claim (oidc mode).
NS_CORE_OIDC_AUDIENCE=

# =============================================================================================
# Public URL
# =============================================================================================
# [generated] Coolify sets it from the domain assigned to the `api` service, e.g. https://api.<tenant-domain>.
# Locally there is no published port: docker compose exec api curl -s localhost:8080/readyz
SERVICE_URL_API=

# =============================================================================================
# Runtime
# =============================================================================================
# [optional] Cron for scheduled refresh: dlt -> dbt -> refresh gate -> publish.
NS_REFRESH_SCHEDULE=0 */6 * * *
# [optional] 1 = keep or restore the last-good generation when a gate fails.
NS_AUTO_ROLLBACK=1
# [optional] Published generations kept (active + rollback target).
NS_GENERATIONS_RETAINED=2

# =============================================================================================
# Backup (manifest backup.target_env = BACKUP_TARGET)
# Coolify's scheduled database backup is the platform backup; these drive Core's own snapshots
# and `ns-core backup`.
# =============================================================================================
# [optional] S3-compatible URL, e.g. s3://<bucket>/<tenant>
BACKUP_TARGET=
# [optional]
BACKUP_S3_ACCESS_KEY_ID=
# [optional]
BACKUP_S3_SECRET_ACCESS_KEY=
# [optional]
NS_BACKUP_SCHEDULE=30 2 * * *

# =============================================================================================
# Telemetry / control plane: outbound only, consent-gated; heartbeat (T0) only when enabled.
# =============================================================================================
# [optional]
NS_CONTROL_PLANE_ENABLED=false

# =============================================================================================
# Source credentials for enabled pipelines (dlt convention SOURCES__<SOURCE>__<KEY>).
# Add each secret here AND list it under the runner's environment in docker-compose.yml.
# =============================================================================================
# SOURCES__EXAMPLE_REST__API_KEY=

# =============================================================================================
# [stub] Surfaces off the initial execution path. They run as separate Coolify resources and keep
# their own env there. Listed only so nobody adds them to Core's resource by accident.
#   Chat edge (Open WebUI or LibreChat): OIDC client, SCIM token, Core MCP URL = ${SERVICE_URL_API}/mcp
#   Model plane (LiteLLM): master key, salt key, its own Postgres, provider API keys
#   Knowledge plane: embedding provider and model (local, or via the model plane)
# =============================================================================================
